# Django/Celery 容器环境模板，复制到 DjangoUserService/.env 后填写密钥。
# Compose 的 environment 优先于 env_file，标注的覆盖项请在 Compose 中修改。

# 环境模式（由 Compose 覆盖）；纯 HTTP 部署需 development。
DJANGO_ENV=development

# 容器中禁用 .env 加载，统一由 Compose 注入配置。
DJANGO_LOAD_DOTENV=false

# 密钥（必填）：至少 50 字符、5 种不同字符，不含 YOUR_。
# Django 密钥须独立于 JWT 密钥。
DJANGO_SECRET_KEY=

# JWT 密钥必须与 backend/.env 的 SECRET_KEY 完全一致。
JWT_SECRET_KEY=
JWT_TOKEN_TTL_SECONDS=86400

# 主机与来源（由 Compose 覆盖）。
# 允许主机须包含服务名 userservice；生产环境禁用通配符。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 来源填写浏览器实际访问的前端地址。
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 请求限流：生产环境按需收紧。
DJANGO_ANON_RATE=1000/minute
DJANGO_USER_RATE=3000/minute

# MySQL（由 Compose 覆盖，与 FastAPI 使用不同数据库）。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=user_service
DB_USER=rag
DB_PASSWORD=

# Celery 与缓存（连接地址由 Compose 覆盖）。
# 容器内 localhost 指向自身，应使用服务名。
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# 注意：以下两个超时参数被 settings.py 的固定值覆盖，不生效。
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=250
CELERY_RESULT_EXPIRES=3600
