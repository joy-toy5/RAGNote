# FastAPI 容器环境模板，复制到 backend/.env 后填写密钥。
# Compose 的 environment 优先于 env_file，标注的覆盖项请在 Compose 中修改。

# 大语言模型：ALIYUN（百炼）或 OLLAMA（本地）。
LLM_TYPE=ALIYUN

# 使用百炼时填写 API 密钥，勿提交真实密钥。
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL_NAME=qwen3.8-flash

# 仅 OLLAMA 使用；地址由 Compose 覆盖，容器内 localhost 指向自身。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen3.5:0.8b

# 嵌入模型：更换模型后需重建向量索引。
EMBED_MODEL_TYPE=ALIYUN
ALIYUN_EMBED_MODEL_NAME=qwen3.7-text-embedding
TEXT_EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b

# 视觉模型：PDF 图片理解。
VISION_MODEL_TYPE=ALIYUN
VISION_CHAT_MODEL_NAME=qwen3.8-max
VISION_OLLAMA_MODEL_NAME=qwen-vl:7b
VISION_BATCH_SIZE=5
VISION_DEDUP_ENABLED=true
VISION_DEDUP_THRESHOLD=10
VISION_BATCH_LOW_RES=true

# 重排序模型（路径由 Compose 覆盖）。
# 请预先准备模型目录，并在 Compose 中配置挂载。
RERANKER_MODEL_PATH=/models/Qwen3-Reranker-0.6B

# MySQL（由 Compose 覆盖）。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=rag
MYSQL_PASSWORD=
MYSQL_DATABASE=chat_history

# 原始文件存储：路径须位于持久化卷内。
RAG_BLOB_STORE_PATH=data/blobs

# Redis（由 Compose 覆盖）。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=3

# 服务配置（由 Compose 覆盖）。
# 容器间使用 HTTP 时需 development；生产模式需配置 HTTPS。
ENV=development
# 生产模式必须启用限流。
RATE_LIMIT_ENABLED=false
# Django 服务地址（由 Compose 覆盖）。
DJANGO_API_URL=http://localhost:8001
# 浏览器访问来源，需与实际前端地址一致。
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# JWT 密钥：必填，与 Django 的 JWT_SECRET_KEY 一致，且不同于 DJANGO_SECRET_KEY。
SECRET_KEY=
ALGORITHM=HS256

# LangSmith 追踪（可选，不填密钥则禁用）。
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-note-local
