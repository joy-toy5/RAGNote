# 环境配置
DJANGO_ENV=development

# 签名密钥配置
DJANGO_SECRET_KEY=YOUR_DJANGO_SECRET_KEY
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
JWT_TOKEN_TTL_SECONDS=86400

# 生产环境安全配置（生产环境必须显式填写）
DJANGO_ALLOWED_HOSTS=rag-note.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://rag-note.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://rag-note.example.com
DJANGO_ANON_RATE=30/minute
DJANGO_USER_RATE=300/minute

# 数据库配置
DB_PORT=YOUR_DB_PORT
DB_NAME=YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_HOST=YOUR_DB_HOST

# Celery 配置
CELERY_BROKER_URL=YOUR_CELERY_BROKER_URL
CELERY_RESULT_BACKEND=YOUR_CELERY_RESULT_BACKEND
CELERY_TASK_TIME_LIMIT=YOUR_CELERY_TASK_TIME_LIMIT
CELERY_TASK_SOFT_TIME_LIMIT=YOUR_CELERY_TASK_SOFT_TIME_LIMIT
CELERY_RESULT_EXPIRES=YOUR_CELERY_RESULT_EXPIRES

# redis 配置
REDIS_CACHE_URL=YOUR_REDIS_CACHE_URL
